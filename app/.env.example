# Quorum agent runtime configuration.
# Copy to .env and fill in. Never commit a real .env.

# Photon (Spectrum) platform — https://photon.codes
# Create a project at https://app.photon.codes and copy the project ID and
# secret from the dashboard.
PROJECT_ID=
PROJECT_SECRET=

# Webhook signing secret: a 64-character secret returned exactly once when a
# webhook URL is registered (dashboard or the Spectrum API). Save it here.
SPECTRUM_SIGNING_SECRET=
PHOTON_ENVIRONMENT=development

# Evidence collection limits.
EVIDENCE_REQUEST_TIMEOUT_MS=8000
EVIDENCE_MAX_REDIRECTS=5

# Persistence. Use :memory: for tests and a file path for local runs.
DATABASE_URL=data/quorum.db

# Retention: message bodies expire after this many days.
CASE_RETENTION_DAYS=30

# Deliberation window before an automatic pause verdict.
DELIBERATION_TIMEOUT_MINUTES=60

# Inbound message size guard.
MAX_MESSAGE_CHARS=4000

# debug | info | warn | error
LOG_LEVEL=info
